# ===================================================================
# SAGHF REAL ESTATE CRM - ENVIRONMENT CONFIGURATION TEMPLATE
# ===================================================================
# Instructions:
# 1. Copy this template to a new file named .env:
#    cp .env.example .env
# 2. Generate a secure secret key for production:
#    python -c "import secrets; print(secrets.token_hex(32))"
# ===================================================================

# Environment Mode: 'development' | 'production' | 'testing'
FLASK_ENV=development
DEBUG=True

# Flask Secret Key for Session Signing & CSRF Protection
# ⚠️ REQUIRED IN PRODUCTION: Replace with a 64+ char random hex string
SECRET_KEY=replace-with-a-secure-random-secret-key-for-production

# Server Host and Port
PORT=5000
HOST=127.0.0.1

# Database Configuration (SQLite default for local development, PostgreSQL/MySQL for production)
DATABASE_URL=sqlite:///saghf_database.db

# Divar Open Platform & Crawler Settings
DIVAR_OPEN_PLATFORM_POST_URL=https://open-api.divar.ir/v2/open-platform/finder/post
DIVAR_API_KEY=
DIVAR_AUTH_TOKEN=

# Telegram Bot Configuration
# 🤖 Obtain token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# 📢 Optional: Channel or Group ID (e.g. @saghf_channel or -1001234567890) for broadcast notifications
TELEGRAM_CHANNEL_ID=
# 🌐 Webhook Public Base URL (e.g. https://your-domain.com)
TELEGRAM_WEBHOOK_URL=

# Super Admin Account & Telegram Authorization
# 👑 Single Super Admin account for web dashboard access
ADMIN_USERNAME=saghf_admin
ADMIN_PASSWORD=SaghfSuperAdmin#2026!
# 📱 Numeric Telegram User ID of Super Admin (e.g. 123456789) for bot control commands
ADMIN_TELEGRAM_ID=
ADMIN_API_KEY=

# Speech-to-Text (STT) Settings (Optional cloud APIs: Vira, IoType or local Whisper)
STT_PROVIDER=auto
STT_API_KEY=
STT_API_ENDPOINT=https://api.iotype.com/v1/transcribe

# Omnichannel Domestic & International Messengers
BALE_BOT_TOKEN=
EITAA_BOT_TOKEN=
RUBIKA_BOT_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
